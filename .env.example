# Optional settings for the website server and its read-only balance proxy.
# No deployment, transaction, keypair, or metadata-upload settings are supported.
PORT=3000
HOST=0.0.0.0

# Optional read-only RPC timeout in milliseconds (default 15000).
USOL_RPC_TIMEOUT_MS=15000

# Server-side Helius Mainnet RPC key for the read-only balance proxy
# (POST /api/rpc). Set it in the server environment (or Base44 Secrets) only —
# never in web/ files, HTML, or committed configuration, so the key is never
# served to the browser. Placeholder only: replace it locally, never commit it.
HELIUS_API_KEY=your-helius-api-key

# Optional alternative: a complete Mainnet RPC URL, used instead of the key above.
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-helius-api-key
